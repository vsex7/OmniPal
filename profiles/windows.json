{
  "id": "windows",
  "name": "Windows 11 习惯模式",
  "description": "还原 Windows 11 常用快捷键（Alt+F4 关闭窗口、Super+方向键贴靠、Super+E 文件管理器、Super+L 锁屏等）",
  "version": "1.0.0",
  "display": {
    "icon": "⊞",
    "brief": "WIN",
    "color": "#3892d6"
  },
  "bindings": [
    {
      "action": "app_launcher",
      "mod": "SUPER",
      "key": "space"
    },
    {
      "action": "close_window",
      "mod": "ALT",
      "key": "F4"
    },
    {
      "action": "snap_left",
      "mod": "SUPER",
      "key": "Left"
    },
    {
      "action": "snap_right",
      "mod": "SUPER",
      "key": "Right"
    },
    {
      "action": "maximize_window",
      "mod": "SUPER",
      "key": "Up"
    },
    {
      "action": "restore_window",
      "mod": "SUPER",
      "key": "Down"
    },
    {
      "action": "file_manager",
      "mod": "SUPER",
      "key": "E"
    },
    {
      "action": "lock_screen",
      "mod": "SUPER CTRL",
      "key": "L"
    },
    {
      "action": "clipboard_history",
      "mod": "SUPER",
      "key": "V"
    },
    {
      "action": "screenshot_region",
      "mod": "SUPER SHIFT",
      "key": "S"
    },
    {
      "action": "emoji_picker",
      "mod": "SUPER",
      "key": "period"
    },
    {
      "action": "omni_settings",
      "mod": "SUPER",
      "key": "I"
    },
    {
      "action": "snap_layouts",
      "mod": "SUPER",
      "key": "Z"
    },
    {
      "action": "workspace_prev",
      "mod": "SUPER CTRL",
      "key": "Left"
    },
    {
      "action": "workspace_next",
      "mod": "SUPER CTRL",
      "key": "Right"
    },
    {
      "action": "screenshot_fullscreen",
      "mod": "",
      "key": "Print"
    },
    {
      "action": "task_view",
      "mod": "SUPER",
      "key": "Tab"
    }
  ],
  "window_mode": "tiled"
}
