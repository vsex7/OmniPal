{
  "id": "mac",
  "name": "macOS 习惯模式",
  "description": "还原 macOS 常用快捷键（Cmd 键转发、Super+Shift+4 区域截图、Super+Ctrl+Q 锁屏、Super+Up 任务概览等）",
  "version": "1.0.0",
  "display": {
    "icon": "◆",
    "brief": "MAC",
    "color": "#d8dee9"
  },
  "bindings": [
    {
      "action": "lock_screen",
      "mod": "SUPER CTRL",
      "key": "Q"
    },
    {
      "action": "maximize_window",
      "mod": "SUPER CTRL",
      "key": "F"
    },
    {
      "action": "screenshot_region",
      "mod": "SUPER SHIFT",
      "key": "4"
    },
    {
      "action": "screenshot_fullscreen",
      "mod": "SUPER SHIFT",
      "key": "3"
    },
    {
      "action": "task_view",
      "mod": "SUPER",
      "key": "Up"
    },
    {
      "action": "workspace_prev",
      "mod": "SUPER CTRL",
      "key": "Left"
    },
    {
      "action": "workspace_next",
      "mod": "SUPER CTRL",
      "key": "Right"
    },
    {
      "action": "snap_left",
      "mod": "SUPER ALT",
      "key": "Left"
    },
    {
      "action": "snap_right",
      "mod": "SUPER ALT",
      "key": "Right"
    },
    {
      "action": "snap_top",
      "mod": "SUPER ALT",
      "key": "Up"
    },
    {
      "action": "snap_bottom",
      "mod": "SUPER ALT",
      "key": "Down"
    },
    {
      "action": "snap_center",
      "mod": "SUPER ALT",
      "key": "C"
    },
    {
      "action": "snap_layouts",
      "mod": "SUPER ALT",
      "key": "Z"
    },
    {
      "action": "file_manager",
      "mod": "SUPER ALT",
      "key": "E"
    },
    {
      "action": "emoji_picker",
      "mod": "SUPER CTRL",
      "key": "space"
    },
    {
      "mod": "SUPER",
      "key": "W",
      "action": "forward_shortcut",
      "forward": "CTRL W",
      "name": "关闭标签页"
    },
    {
      "mod": "SUPER",
      "key": "T",
      "action": "forward_shortcut",
      "forward": "CTRL T",
      "name": "新建标签页"
    },
    {
      "mod": "SUPER SHIFT",
      "key": "T",
      "action": "forward_shortcut",
      "forward": "CTRL SHIFT T",
      "name": "恢复关闭的标签页"
    },
    {
      "mod": "SUPER",
      "key": "F",
      "action": "forward_shortcut",
      "forward": "CTRL F",
      "name": "查找"
    },
    {
      "mod": "SUPER",
      "key": "Z",
      "action": "forward_shortcut",
      "forward": "CTRL Z",
      "name": "撤销"
    },
    {
      "mod": "SUPER SHIFT",
      "key": "Z",
      "action": "forward_shortcut",
      "forward": "CTRL SHIFT Z",
      "name": "重做"
    },
    {
      "mod": "SUPER",
      "key": "S",
      "action": "forward_shortcut",
      "forward": "CTRL S",
      "name": "保存"
    },
    {
      "mod": "SUPER",
      "key": "R",
      "action": "forward_shortcut",
      "forward": "CTRL R",
      "name": "刷新页面"
    },
    {
      "mod": "SUPER",
      "key": "1",
      "action": "forward_shortcut",
      "forward": "CTRL 1",
      "name": "切换到第1个标签页"
    },
    {
      "mod": "SUPER",
      "key": "2",
      "action": "forward_shortcut",
      "forward": "CTRL 2",
      "name": "切换到第2个标签页"
    },
    {
      "mod": "SUPER",
      "key": "3",
      "action": "forward_shortcut",
      "forward": "CTRL 3",
      "name": "切换到第3个标签页"
    },
    {
      "mod": "SUPER",
      "key": "4",
      "action": "forward_shortcut",
      "forward": "CTRL 4",
      "name": "切换到第4个标签页"
    },
    {
      "mod": "SUPER",
      "key": "5",
      "action": "forward_shortcut",
      "forward": "CTRL 5",
      "name": "切换到第5个标签页"
    },
    {
      "mod": "SUPER",
      "key": "6",
      "action": "forward_shortcut",
      "forward": "CTRL 6",
      "name": "切换到第6个标签页"
    },
    {
      "mod": "SUPER",
      "key": "7",
      "action": "forward_shortcut",
      "forward": "CTRL 7",
      "name": "切换到第7个标签页"
    },
    {
      "mod": "SUPER",
      "key": "8",
      "action": "forward_shortcut",
      "forward": "CTRL 8",
      "name": "切换到第8个标签页"
    },
    {
      "mod": "SUPER",
      "key": "9",
      "action": "forward_shortcut",
      "forward": "CTRL 9",
      "name": "切换到第9个标签页"
    },
    {
      "action": "app_switch_next",
      "mod": "SUPER",
      "key": "Tab"
    },
    {
      "action": "app_switch_prev",
      "mod": "SUPER SHIFT",
      "key": "Tab"
    }
  ],
  "window_mode": "floating"
}
