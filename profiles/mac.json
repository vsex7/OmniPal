{
  "id": "mac",
  "name": "macOS 习惯模式",
  "description": "还原 macOS 常用快捷键（Super+Q 关闭窗口、Super+Space 启动器、Super+Shift+4 区域截图、Super+Ctrl+Q 锁屏等）",
  "version": "1.0.0",
  "display": {
    "icon": "◆",
    "brief": "MAC",
    "color": "#d8dee9"
  },
  "bindings": [
    {
      "action": "close_window",
      "mod": "SUPER",
      "key": "Q"
    },
    {
      "action": "app_launcher",
      "mod": "SUPER",
      "key": "space"
    },
    {
      "action": "lock_screen",
      "mod": "SUPER CTRL",
      "key": "Q"
    },
    {
      "action": "maximize_window",
      "mod": "SUPER CTRL",
      "key": "F"
    },
    {
      "action": "screenshot_region",
      "mod": "SUPER SHIFT",
      "key": "4"
    },
    {
      "action": "screenshot_fullscreen",
      "mod": "SUPER SHIFT",
      "key": "3"
    },
    {
