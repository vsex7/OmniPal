#!/usr/bin/env python3
"""
OmniPal Command-Line Interface (omni-profile)
Direct controller for OmniPal runtime engine.
"""

import argparse
import json
import sys
from pathlib import Path

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from engine.engine import OmniPalEngine, run_daemon, stats_file_path

try:
    from engine.phone_runner import (
        load_devices_config,
        save_devices_config,
        get_phone_status,
        start_phone_mirror,
        stop_phone_mirror,
        toggle_phone_mirror,
        diagnose_phone_environment,
        get_devices_config_path,
    )
except ImportError:
    def load_devices_config():
        return {"auto_wifi": True, "default_bitrate": "4M", "devices": []}
    def save_devices_config(cfg):
        return False
    def get_phone_status():
        return {"running": False, "devices": [], "pids": []}
    def start_phone_mirror(device_id=None):
        return False
    def stop_phone_mirror(device_id=None):
        return False
    def toggle_phone_mirror(device_id=None):
        return False
    def diagnose_phone_environment():
        return {"verdict": "error", "suggestions": ["phone_runner 模块未就绪"]}
    def get_devices_config_path():
        return Path.home() / ".config" / "omnipal" / "devices.json"

def cmd_status(engine: OmniPalEngine, args):
    state = engine.get_state()
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
    else:
        print("OmniPal 状态信息:")
        print(f"  当前模式: {state.get('name', state.get('mode'))} ({state.get('mode')})")
        print(f"  生效快捷键数: {state.get('active_bindings_count', 0)}")
        print(f"  窗口策略: {state.get('window_policy', 'tiled')} (生效: {state.get('effective_window_mode', 'tiled')})")
        print(f"  Compositor: {'已连通' if state.get('compositor_connected') else '未连通'}")
        print(f"  引擎状态: {state.get('status', 'idle')}")
        if "updated_at" in state:
            print(f"  更新时间: {state.get('updated_at')}")

def cmd_window_policy(engine: OmniPalEngine, args):
    action = getattr(args, "policy_action", None)
    target_policy = getattr(args, "target_policy", None) or getattr(args, "policy", None)

    if action == "set" or target_policy or (action and action not in ["status"] and not getattr(args, "json", False)):
        policy = (target_policy or action).lower().strip()
        if not engine.set_window_policy(policy):
            print(f"❌ 无效的窗口策略: {policy}。可用策略: tiled, floating, follow-profile (或别名: tile, float, follow)", file=sys.stderr)
            sys.exit(1)
        state = engine.get_state()
        if getattr(args, "json", False):
            print(json.dumps({
                "success": True,
                "window_policy": state.get("window_policy"),
                "effective_window_mode": state.get("effective_window_mode")
            }, indent=2, ensure_ascii=False))
        else:
            print(f"✅ 窗口策略已更新为: {state.get('window_policy')} (生效模式: {state.get('effective_window_mode')})")
        return

    state = engine.get_state()
    if getattr(args, "json", False):
        print(json.dumps({
            "window_policy": state.get("window_policy", "tiled"),
            "effective_window_mode": state.get("effective_window_mode", "tiled")
        }, indent=2, ensure_ascii=False))
        return

    print("📐 OmniPal 窗口布局策略 (Window Policy):")
    print(f"  • 当前策略: {state.get('window_policy', 'tiled')}")
    print(f"  • 实际生效: {state.get('effective_window_mode', 'tiled')}")

def cmd_switch(engine: OmniPalEngine, args):
    mode = args.mode.lower().strip()
    try:
        success = engine.switch_mode(mode)
        if success:
            state = engine.get_state()
            print(f"✅ 已切换至: {state.get('name')} ({mode})")
        else:
            print(f"❌ 切换至 {mode} 失败", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"❌ 错误: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_cycle(engine: OmniPalEngine, args):
    try:
        reverse = getattr(args, "reverse", False)
        next_mode = engine.cycle_mode(reverse=reverse)
        state = engine.get_state()
        print(f"🔄 已轮转至: {state.get('name')} ({next_mode})")
    except Exception as e:
        print(f"❌ 轮转失败: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_restore(engine: OmniPalEngine, args):
    try:
        success = engine.restore()
        if success:
            print("✅ 已恢复系统原始快捷键绑定（零残留）")
        else:
            print("❌ 恢复原始绑定时发生错误", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"❌ 恢复失败: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_cheatsheet(engine: OmniPalEngine, args):
    if args.mode:
        clean_mode = args.mode.lower().strip()
        if clean_mode not in engine.profiles:
            print(f"Error: Unknown profile '{clean_mode}'. Available profiles: {', '.join(sorted(engine.profiles.keys()))}", file=sys.stderr)
            sys.exit(2)
    sheet = engine.cheatsheet(args.mode)
    state = engine.get_state()
    mode_name = args.mode or state.get("mode", "omarchy")
    if args.json:
        print(json.dumps(sheet, indent=2, ensure_ascii=False))
        return

    print(f"=== OmniPal 快捷键速查表 [{mode_name}] ===")
    if not sheet:
        print("  （原生模式下使用系统默认快捷键，无覆盖）")
        return

    col1_w = max(len(item["key"]) for item in sheet) + 2
    col2_w = max(len(item["name"]) for item in sheet) + 4

    print(f"{'快捷键'.ljust(col1_w)}{'功能名称'.ljust(col2_w)}{'功能描述'}")
    print("-" * 65)
    for item in sheet:
        key_str = item["key"].ljust(col1_w)
        name_str = item["name"].ljust(col2_w)
        desc_str = item["description"]
        print(f"{key_str}{name_str}{desc_str}")

def cmd_snap(engine: OmniPalEngine, args):
    success = engine.snap(args.zone, target_address=getattr(args, "address", None), no_hud=getattr(args, "no_hud", False))
    if not success:
        sys.exit(1)

def cmd_snap_layouts(engine: OmniPalEngine, args):
    data = {
        "templates": engine.get_snap_layouts(),
        "zones": engine.get_snap_zones()
    }
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    print("📐 OmniPal 规范窗口吸附布局与区域:")
    for tpl in engine.get_snap_layouts():
        print(f"  • [{tpl['key']}] {tpl['title']} ({tpl['hint']}): {len(tpl['slots'])} 个分区")

def cmd_benchmark(engine: OmniPalEngine, args):
    res = engine.benchmark()
    if args.json:
        print(json.dumps(res, indent=2))
        return
    print("⚡ OmniPal 性能基准测试与耗时统计:")
    print(f"  • Schema & Profile 解析: {res.get('parse_ms')} ms")
    print(f"  • 批量绑定覆盖 (Windows): {res.get('switch_windows_ms')} ms")
    print(f"  • 批量绑定覆盖 (macOS):   {res.get('switch_mac_ms')} ms")
    print(f"  • 撤销清理耗时 (Restore): {res.get('restore_ms')} ms")
    print(f"  • tmpfs 状态写入广播:     {res.get('state_write_ms')} ms")
    avg = round((res.get('switch_windows_ms', 0) + res.get('switch_mac_ms', 0)) / 2, 2)
    print(f"\n🚀 平均内存热切换延迟: {avg} ms（严守 < 5ms 规范指标）")
    if res.get("mode_restored"):
        print("ℹ️ 基准测试非破坏性执行：已自动恢复测试前的活动模式（未计入统计）")

def cmd_doctor(engine: OmniPalEngine, args):
    diag = engine.doctor()
    if args.json:
        print(json.dumps(diag, indent=2, ensure_ascii=False))
        if not diag["healthy"]:
            sys.exit(1)
        return

    print("🩺 OmniPal 系统健康诊断与一致性报告:")
    print(f"  • 版本: {diag['version']}")
    print(f"  • 状态: {'✅ 健康' if diag['healthy'] else '❌ 存在异常'}")

    daemon_info = diag.get("daemon", {})
    if daemon_info.get("running"):
        print(f"  • 守护进程 (Daemon): 运行中 (PID {daemon_info.get('pid')})")
    else:
        print("  • 守护进程 (Daemon): 未运行 (无活动常驻进程)")

    sock_info = diag.get("socket2", {})
    if sock_info.get("connected"):
        print(f"  • Hyprland Socket2: 已连通 ({sock_info.get('path')})")
    else:
        print(f"  • Hyprland Socket2: ❌ 未连通 ({sock_info.get('path') or '未找到'})")

    state = diag.get("state", {})
    print(f"  • 当前模式: {state.get('name', '未知')} ({state.get('mode', '未知')})")

    ov = diag.get("overlay", {})
    print(f"  • 内存热绑定生效: {ov.get('verified_in_hyprland')}/{ov.get('count')} 项匹配")

    print(f"  • Schema 与 Profile 一致性: {'✅ 100% 校验通过' if diag.get('consistency') else '❌ 校验失败'}")

    issues = diag.get("issues", [])
    if issues:
        print("\n⚠️ 诊断发现的问题:")
        for iss in issues:
            print(f"    - {iss}")
        sys.exit(1)
    else:
        print("\n🎉 系统运行良好，无冲突与异常。")

def cmd_list(engine: OmniPalEngine, args):
    profiles = engine.list_profiles()
    if args.json:
        print(json.dumps(profiles, ensure_ascii=False))
        return
    print(f"{'模式 ID'.ljust(12)}{'模式名称'.ljust(22)}{'快捷键数'.ljust(10)}{'来源'.ljust(12)}{'说明'}")
    print("-" * 75)
    for p in profiles:
        src = "用户目录" if p["source"] == "user" else "项目内置"
        if p.get("override"):
            src += " (覆盖)"
        print(f"{p['id'].ljust(12)}{p['name'].ljust(22)}{str(p['bindings_count']).ljust(10)}{src.ljust(12)}{p['description']}")

def cmd_persist(engine: OmniPalEngine, args):
    action = getattr(args, "persist_action", None)

    if action == "status":
        status = engine.get_persistence_status()
        if args.json:
            print(json.dumps(status, indent=2, ensure_ascii=False))
            return
        if status["enabled"]:
            print("💾 OmniPal 配置持久化: ✅ 已启用（关机/重启自动记住上次配置）")
            print(f"  • 持久化模式 (Profile): {status.get('profile') or '跟随当前'}")
            print(f"  • 窗口策略 (Window Policy): {status.get('window_policy') or '跟随当前'}")
            print(f"  • 最近更新: {status.get('updated_at') or '未知'}")
        else:
            print("💾 OmniPal 配置持久化: ⏸ 已禁用（重启不恢复上次配置；本地统计仍独立记录）")
        print(f"  • 配置文件: {status['path']}")
        return

    if action == "enable":
        policy = getattr(args, "policy", None)
        if not engine.set_persistence(True, profile=args.profile, window_policy=policy):
            print("❌ 启用持久化被拒绝：模式或策略无效，或配置写入失败", file=sys.stderr)
            sys.exit(1)
        status = engine.get_persistence_status()
        print(f"✅ 已启用配置持久化: 模式 '{status['profile']}', 策略 '{status.get('window_policy')}' 记录于 {status['path']}")
        print("   后续 switch / cycle / 策略调整后将自动同步持久化（可随时执行 persist disable 关闭）。")
        return

    if action == "disable":
        if not engine.set_persistence(False):
            print("❌ 关闭持久化失败，请检查配置文件权限", file=sys.stderr)
            sys.exit(1)
        print("✅ 已关闭配置持久化（重启后不恢复；本地统计仍由 stats.json 独立记录）")
        return

    print("用法: omni-profile persist <status|enable|disable>", file=sys.stderr)
    sys.exit(1)

def _print_stat_rank(title: str, counts: dict, top: int = 10):
    print(f"\n{title}")
    if not counts:
        print("  （暂无记录）")
        return
    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], str(kv[0])))[:top]
    for i, (name, cnt) in enumerate(ranked, 1):
        print(f"  {i}. {str(name).ljust(22)}{cnt} 次")

def cmd_stats(engine: OmniPalEngine, args):
    if args.reset:
        if not engine.reset_stats():
            print("❌ 重置本地使用统计失败", file=sys.stderr)
            sys.exit(1)
        print("✅ 已重置本地使用统计（stats.json 计数已全部清空）")

    stats = engine.get_stats()
    if args.json:
        print(json.dumps(stats, indent=2, ensure_ascii=False))
        return

    total = sum(stats["switches"].values()) + sum(stats["snaps"].values()) + sum(stats["actions"].values())
    print("📊 OmniPal 本地使用统计（纯本地聚合计数，零按键内容记录，零网络上传）")
    print(f"  • 统计文件: {stats_file_path()}")
    print(f"  • 累计事件: {total}")
    print(f"  • 最近更新: {stats.get('last_updated') or '无'}")
    print(f"  • 上次重置: {stats.get('last_reset') or '从未'}")
    _print_stat_rank("🔁 模式切换频次排行:", stats["switches"])
    _print_stat_rank("🧲 吸附区域使用 Top 榜:", stats["snaps"])
    _print_stat_rank("⚡ 动作触发统计排行:", stats["actions"])

def cmd_phone(engine: OmniPalEngine, args):
    action = getattr(args, "phone_action", None) or "status"
    target = getattr(args, "device", None)

    if action == "status":
        st = get_phone_status()
        if getattr(args, "json", False):
            print(json.dumps(st, indent=2, ensure_ascii=False))
            return
        running = st.get("running", False)
        print(f"📱 手机同屏协同 (scrcpy) 状态: {'投屏中 (运行)' if running else '未运行'}")
        pids = st.get("pids", [])
        if pids:
            print(f"  • 活动进程 PID: {', '.join(map(str, pids))}")
        devs = st.get("devices", [])
        if devs:
            print(f"  • 协同设备 ({len(devs)} 台):")
            for d in devs:
                dev_run = " [● 投屏中]" if d.get("running") else ""
                geom = d.get("geometry", {})
                geom_str = f"{geom.get('width', 0)}x{geom.get('height', 0)}+{geom.get('x', 0)}+{geom.get('y', 0)}" if geom else "自动"
                print(f"    - [{d.get('id', 'device')}] {d.get('name', 'Device')}{dev_run} (Serial: {d.get('serial', 'N/A')}, IP: {d.get('ip', 'N/A')}, 窗口: {geom_str})")
        else:
            print("  • 协同设备: （暂无配置设备）")
    elif action == "list":
        cfg = load_devices_config()
        devs = cfg.get("devices", []) if isinstance(cfg, dict) else []
        if getattr(args, "json", False):
            print(json.dumps(devs, indent=2, ensure_ascii=False))
            return
        print(f"📱 已配置协同设备列表 ({len(devs)} 台):")
        if not devs:
            print("  （暂无配置设备）")
        for d in devs:
            geom = d.get("geometry", {})
            geom_str = f"{geom.get('width', 0)}x{geom.get('height', 0)}+{geom.get('x', 0)}+{geom.get('y', 0)}" if geom else "自动"
            print(f"  • [{d.get('id', 'device')}] {d.get('name', 'Device')}")
            print(f"      Serial: {d.get('serial', 'N/A')} | IP: {d.get('ip', 'N/A')} | 窗口几何: {geom_str}")
    elif action == "doctor":
        diag = diagnose_phone_environment()
        if getattr(args, "json", False):
            print(json.dumps(diag, indent=2, ensure_ascii=False))
            return
        verdict_icons = {"ready": "✅ 良好", "degraded": "⚠️ 注意", "error": "❌ 异常"}
        v_icon = verdict_icons.get(diag.get("verdict", "error"), "❓ 未知")
        print(f"🩺 手机协同环境与连通性诊断: {v_icon}")
        scrcpy_info = diag.get("scrcpy", {})
        print(f"  • scrcpy: {'✅ 已安装' if scrcpy_info.get('installed') else '❌ 未安装'} ({scrcpy_info.get('version') or 'N/A'})")
        adb_info = diag.get("adb", {})
        print(f"  • adb 服务: {'✅ 正常运行' if adb_info.get('server_ok') else '❌ 服务异常'}")
        devs = diag.get("devices", [])
        if devs:
            print(f"  • 设备连接状态检测 ({len(devs)} 台):")
            for d in devs:
                usb_str = f"USB: {d.get('usb_state')}"
                wifi_str = f"Wi-Fi(5555): {'连通' if d.get('wifi_port_5555') else '不可达'}"
                st_icon = "✅ 在线" if d.get("status") == "ready" else "○ 离线"
                print(f"    - [{d.get('id')}] {d.get('name')}: {st_icon} ({usb_str}, {wifi_str})")
        if diag.get("suggestions"):
            print("  • 修复建议:")
            for s in diag["suggestions"]:
                print(f"    💡 {s}")
    elif action == "config":
        p = get_devices_config_path()
        if getattr(args, "json", False):
            print(json.dumps(load_devices_config(), indent=2, ensure_ascii=False))
        else:
            print(f"⚙️ 手机协同设备配置文件路径: {p}")
            if p.exists():
                print(p.read_text(encoding="utf-8"))
    elif action == "start":
        res = start_phone_mirror(target)
        tgt_label = f"[{target}] " if target else ""
        if res:
            print(f"✅ {tgt_label}手机同屏协同已启动")
        else:
            print(f"❌ {tgt_label}启动手机同屏协同失败 (请运行 omni-profile phone doctor 排查)", file=sys.stderr)
            sys.exit(1)
    elif action == "stop":
        res = stop_phone_mirror(target)
        tgt_label = f"[{target}] " if target else ""
        if res:
            print(f"✅ {tgt_label}手机同屏协同已停止")
        else:
            print(f"❌ {tgt_label}停止手机同屏协同失败", file=sys.stderr)
            sys.exit(1)
    elif action == "toggle":
        st_before = get_phone_status()
        was_running = st_before.get("running") if not target else any(
            d.get("running") for d in st_before.get("devices", [])
            if d.get("id") == target or d.get("serial") == target
        )
        res = toggle_phone_mirror(target)
        st = get_phone_status()
        tgt_label = f"[{target}] " if target else ""
        if target:
            d = next(
                (x for x in st.get("devices", []) if x.get("id") == target or x.get("serial") == target),
                None,
            )
            is_run = d.get("running") if d else st.get("running")
        else:
            is_run = st.get("running")

        if was_running:
            if res and not is_run:
                print(f"✅ {tgt_label}手机同屏协同已停止")
            else:
                print(f"❌ {tgt_label}停止手机同屏协同失败", file=sys.stderr)
                sys.exit(1)
        else:
            if res and is_run:
                print(f"✅ {tgt_label}手机同屏协同已启动")
            else:
                print(f"❌ {tgt_label}启动手机同屏协同失败 (请运行 omni-profile phone doctor 排查)", file=sys.stderr)
                sys.exit(1)
    else:
        print(f"❌ 未知的手机协同子命令: {action}。可用: status, start, stop, toggle, list, doctor, config", file=sys.stderr)
        sys.exit(1)

def main():
    engine = OmniPalEngine(PROJECT_ROOT)

    parser = argparse.ArgumentParser(
        prog="omni-profile",
        description="OmniPal 运行时内存热切换控制工具 (v1.8.0)"
    )
    subparsers = parser.add_subparsers(dest="command", help="子命令")

    # status
    p_status = subparsers.add_parser("status", help="查看当前模式与状态")
    p_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_status.set_defaults(func=cmd_status)

    # list
    p_list = subparsers.add_parser("list", help="列出所有可用快捷键模式（内置与用户自定义）")
    p_list.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_list.set_defaults(func=cmd_list)

    # switch
    p_switch = subparsers.add_parser("switch", help="切换至指定快捷键模式")
    p_switch.add_argument("mode", help="目标模式 (如 windows, mac, omarchy 或用户自定义模式)")
    p_switch.set_defaults(func=cmd_switch)

    # cycle
    p_cycle = subparsers.add_parser("cycle", help="在可用模式间轮转切换")
    p_cycle.add_argument("--reverse", action="store_true", help="反向轮转切换")
    p_cycle.set_defaults(func=cmd_cycle)

    # restore
    p_restore = subparsers.add_parser("restore", help="撤销所有覆盖，恢复系统原始快捷键")
    p_restore.set_defaults(func=cmd_restore)

    # cheatsheet
    p_cheat = subparsers.add_parser("cheatsheet", help="查看当前模式快捷键速查表")
    p_cheat.add_argument("mode", nargs="?", default=None, help="指定模式（默认当前）")
    p_cheat.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_cheat.set_defaults(func=cmd_cheatsheet)

    # snap
    p_snap = subparsers.add_parser("snap", help="触发窗口吸附分屏或呼出吸附布局菜单")
    p_snap.add_argument("zone", help="目标吸附区域 (如 left, right, top-left, center, third-center) 或 layouts (呼出选择器)")
    p_snap.add_argument("address", nargs="?", default=None, help="目标窗口十六进制地址 (如 0x56c7c335e060，默认探测鼠标悬停窗口或活动窗口)")
    p_snap.add_argument("--no-hud", action="store_true", help="静默吸附，不弹出视觉 HUD 反馈")
    p_snap.set_defaults(func=cmd_snap)

    # snap-layouts
    p_snap_layouts = subparsers.add_parser("snap-layouts", help="获取规范窗口吸附布局与区域配置")
    p_snap_layouts.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_snap_layouts.set_defaults(func=cmd_snap_layouts)

    # benchmark
    p_bench = subparsers.add_parser("benchmark", help="执行性能基准测试与耗时统计")
    p_bench.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_bench.set_defaults(func=cmd_benchmark)

    # doctor
    p_doc = subparsers.add_parser("doctor", help="执行系统状态与按键一致性健康诊断")
    p_doc.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_doc.set_defaults(func=cmd_doctor)

    # daemon
    p_daemon = subparsers.add_parser("daemon", help="前台运行守护进程（带自动退出恢复）")
    p_daemon.set_defaults(func=lambda eng, args: run_daemon())

    # persist
    p_persist = subparsers.add_parser("persist", help="管理配置持久化（默认开启，自动记住关机前配置）")
    persist_sub = p_persist.add_subparsers(dest="persist_action", required=True, help="持久化操作")
    p_p_status = persist_sub.add_parser("status", help="查看持久化状态与配置文件路径")
    p_p_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_p_status.set_defaults(func=cmd_persist)
    p_p_enable = persist_sub.add_parser("enable", help="启用持久化并记录目标模式与策略（默认当前模式）")
    p_p_enable.add_argument("profile", nargs="?", default=None, help="要持久化的模式（默认当前已激活模式；非法模式将被拒绝）")
    p_p_enable.add_argument("--policy", choices=["tiled", "floating"], default=None, help="要持久化的窗口策略（默认当前策略）")
    p_p_enable.set_defaults(func=cmd_persist)
    p_p_disable = persist_sub.add_parser("disable", help="关闭重启恢复（本地统计仍独立记录）")
    p_p_disable.set_defaults(func=cmd_persist)

    # stats
    p_stats = subparsers.add_parser("stats", help="查看本地使用统计（切换/吸附/动作排行，完全本地零上传；--reset 清空）")
    p_stats.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_stats.add_argument("--reset", action="store_true", help="清空并重置全部本地统计")
    p_stats.set_defaults(func=cmd_stats)

    # window-policy / window-mode
    for cmd_name in ["window-policy", "window-mode"]:
        p_wp = subparsers.add_parser(cmd_name, help="查看或设置窗口策略 (tiled / floating / follow-profile)")
        p_wp.add_argument("--json", action="store_true", help="以 JSON 格式输出状态")
        p_wp.set_defaults(func=cmd_window_policy, policy_action="status")
        wp_sub = p_wp.add_subparsers(dest="policy_action", help="策略操作")

        wp_status = wp_sub.add_parser("status", help="查看当前窗口策略状态")
        wp_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
        wp_status.set_defaults(func=cmd_window_policy)

        wp_set = wp_sub.add_parser("set", help="设置窗口策略")
        wp_set.add_argument("policy", help="目标策略 (tiled, floating, follow-profile 或别名)")
        wp_set.add_argument("--json", action="store_true", help="以 JSON 格式输出结果")
        wp_set.set_defaults(func=cmd_window_policy)

        for direct_p in ["tiled", "tile", "floating", "float", "follow-profile", "follow", "follow_profile"]:
            wp_direct = wp_sub.add_parser(direct_p, help=f"快速切换至策略: {direct_p}")
            wp_direct.add_argument("--json", action="store_true", help="以 JSON 格式输出结果")
            wp_direct.set_defaults(func=cmd_window_policy, policy_action="set", target_policy=direct_p)

    # phone
    p_phone = subparsers.add_parser("phone", help="管理手机同屏协同 (scrcpy 多设备投屏)")
    p_phone.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_phone.set_defaults(func=cmd_phone, phone_action="status")
    phone_sub = p_phone.add_subparsers(dest="phone_action", help="手机协同操作")

    ph_status = phone_sub.add_parser("status", help="查看手机同屏运行状态与设备")
    ph_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    ph_status.set_defaults(func=cmd_phone)

    ph_start = phone_sub.add_parser("start", help="启动手机同屏投屏")
    ph_start.add_argument("device", nargs="?", default=None, help="目标设备 ID（如 redmi-12t），留空则启动全部")
    ph_start.set_defaults(func=cmd_phone)

    ph_stop = phone_sub.add_parser("stop", help="停止手机同屏投屏")
    ph_stop.add_argument("device", nargs="?", default=None, help="目标设备 ID（如 redmi-12t），留空则停止全部")
    ph_stop.set_defaults(func=cmd_phone)

    ph_toggle = phone_sub.add_parser("toggle", help="切换启动/停止手机同屏投屏")
    ph_toggle.add_argument("device", nargs="?", default=None, help="目标设备 ID（如 redmi-12t），留空则切换全部")
    ph_toggle.set_defaults(func=cmd_phone)

    ph_list = phone_sub.add_parser("list", help="列出已配置的协同设备")
    ph_list.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    ph_list.set_defaults(func=cmd_phone)

    ph_doctor = phone_sub.add_parser("doctor", help="诊断 scrcpy、adb 与手机网络/USB 连通性")
    ph_doctor.add_argument("--json", action="store_true", help="以 JSON 格式输出诊断报告")
    ph_doctor.set_defaults(func=cmd_phone)

    ph_config = phone_sub.add_parser("config", help="查看或输出设备配置文件路径")
    ph_config.add_argument("--json", action="store_true", help="以 JSON 格式输出配置内容")
    ph_config.set_defaults(func=cmd_phone)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(engine, args)

if __name__ == "__main__":
    main()
