#!/usr/bin/env python3
"""
OmniPal Command-Line Interface (omni-profile)
Direct controller for OmniPal runtime engine.
"""

import argparse
import json
import sys
from pathlib import Path

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from engine.engine import OmniPalEngine, run_daemon, stats_file_path, LUA_DISPATCHERS

def cmd_status(engine: OmniPalEngine, args):
    state = engine.get_state()
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
    else:
        print("OmniPal 状态信息:")
        print(f"  当前模式: {state.get('name', state.get('mode'))} ({state.get('mode')})")
        print(f"  生效快捷键数: {state.get('active_bindings_count', 0)}")
        print(f"  窗口策略: {state.get('window_policy', 'tiled')} (生效: {state.get('effective_window_mode', 'tiled')})")
        print(f"  Compositor: {'已连通' if state.get('compositor_connected') else '未连通'}")
        print(f"  引擎状态: {state.get('status', 'idle')}")
        if "updated_at" in state:
            print(f"  更新时间: {state.get('updated_at')}")

def cmd_window_policy(engine: OmniPalEngine, args):
    action = getattr(args, "policy_action", None)
    target_policy = getattr(args, "target_policy", None) or getattr(args, "policy", None)

    if action == "set" or target_policy or (action and action not in ["status"] and not getattr(args, "json", False)):
        policy = (target_policy or action).lower().strip()
        if not engine.set_window_policy(policy):
            print(f"❌ 无效的窗口策略: {policy}。可用策略: tiled, floating, follow-profile (或别名: tile, float, follow)", file=sys.stderr)
            sys.exit(1)
        state = engine.get_state()
        if getattr(args, "json", False):
            print(json.dumps({
                "success": True,
                "window_policy": state.get("window_policy"),
                "effective_window_mode": state.get("effective_window_mode")
            }, indent=2, ensure_ascii=False))
        else:
            print(f"✅ 窗口策略已更新为: {state.get('window_policy')} (生效模式: {state.get('effective_window_mode')})")
        return

    state = engine.get_state()
    if getattr(args, "json", False):
        print(json.dumps({
            "window_policy": state.get("window_policy", "tiled"),
            "effective_window_mode": state.get("effective_window_mode", "tiled")
        }, indent=2, ensure_ascii=False))
        return

    print("📐 OmniPal 窗口布局策略 (Window Policy):")
    print(f"  • 当前策略: {state.get('window_policy', 'tiled')}")
    print(f"  • 实际生效: {state.get('effective_window_mode', 'tiled')}")

def cmd_switch(engine: OmniPalEngine, args):
    mode = args.mode.lower().strip()
    try:
        success = engine.switch_mode(mode)
        if success:
            state = engine.get_state()
            print(f"✅ 已切换至: {state.get('name')} ({mode})")
        else:
            print(f"❌ 切换至 {mode} 失败", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"❌ 错误: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_cycle(engine: OmniPalEngine, args):
    try:
        reverse = getattr(args, "reverse", False)
        next_mode = engine.cycle_mode(reverse=reverse)
        state = engine.get_state()
        print(f"🔄 已轮转至: {state.get('name')} ({next_mode})")
    except Exception as e:
        print(f"❌ 轮转失败: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_restore(engine: OmniPalEngine, args):
    try:
        success = engine.restore()
        if success:
            print("✅ 已恢复系统原始快捷键绑定（零残留）")
        else:
            print("❌ 恢复原始绑定时发生错误", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"❌ 恢复失败: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_cheatsheet(engine: OmniPalEngine, args):
    if args.mode:
        clean_mode = args.mode.lower().strip()
        if clean_mode not in engine.profiles:
            print(f"Error: Unknown profile '{clean_mode}'. Available profiles: {', '.join(sorted(engine.profiles.keys()))}", file=sys.stderr)
            sys.exit(2)
    sheet = engine.cheatsheet(args.mode)
    state = engine.get_state()
    mode_name = args.mode or state.get("mode", "omarchy")
    if args.json:
        print(json.dumps(sheet, indent=2, ensure_ascii=False))
        return

    print(f"=== OmniPal 快捷键速查表 [{mode_name}] ===")
    if not sheet:
        print("  （原生模式下使用系统默认快捷键，无覆盖）")
        return

    col1_w = max(len(item["key"]) for item in sheet) + 2
    col2_w = max(len(item["name"]) for item in sheet) + 4

    print(f"{'快捷键'.ljust(col1_w)}{'功能名称'.ljust(col2_w)}{'功能描述'}")
    print("-" * 65)
    for item in sheet:
        key_str = item["key"].ljust(col1_w)
        name_str = item["name"].ljust(col2_w)
        desc_str = item["description"]
        print(f"{key_str}{name_str}{desc_str}")

def cmd_send(engine: OmniPalEngine, args):
    if not engine.send_shortcut(" ".join(args.keys), window_class=args.window_class):
        sys.exit(1)

def cmd_snap(engine: OmniPalEngine, args):
    success = engine.snap(args.zone, target_address=getattr(args, "address", None), no_hud=getattr(args, "no_hud", False))
    if not success:
        sys.exit(1)

def cmd_snap_layouts(engine: OmniPalEngine, args):
    data = {
        "templates": engine.get_snap_layouts(),
        "zones": engine.get_snap_zones()
    }
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    print("📐 OmniPal 规范窗口吸附布局与区域:")
    for tpl in engine.get_snap_layouts():
        print(f"  • [{tpl['key']}] {tpl['title']} ({tpl['hint']}): {len(tpl['slots'])} 个分区")

def cmd_benchmark(engine: OmniPalEngine, args):
    res = engine.benchmark()
    if args.json:
        print(json.dumps(res, indent=2))
        return
    print("⚡ OmniPal 性能基准测试与耗时统计:")
    print(f"  • Schema & Profile 解析: {res.get('parse_ms')} ms")
    print(f"  • 批量绑定覆盖 (Windows): {res.get('switch_windows_ms')} ms")
    print(f"  • 批量绑定覆盖 (macOS):   {res.get('switch_mac_ms')} ms")
    print(f"  • 撤销清理耗时 (Restore): {res.get('restore_ms')} ms")
    print(f"  • tmpfs 状态写入广播:     {res.get('state_write_ms')} ms")
    avg = round((res.get('switch_windows_ms', 0) + res.get('switch_mac_ms', 0)) / 2, 2)
    print(f"\n🚀 平均内存热切换延迟: {avg} ms（严守 < 5ms 规范指标）")
    if res.get("mode_restored"):
        print("ℹ️ 基准测试非破坏性执行：已自动恢复测试前的活动模式（未计入统计）")

def cmd_doctor(engine: OmniPalEngine, args):
    diag = engine.doctor()
    if args.json:
        print(json.dumps(diag, indent=2, ensure_ascii=False))
        if not diag["healthy"]:
            sys.exit(1)
        return

    print("🩺 OmniPal 系统健康诊断与一致性报告:")
    print(f"  • 版本: {diag['version']}")
    print(f"  • 状态: {'✅ 健康' if diag['healthy'] else '❌ 存在异常'}")

    daemon_info = diag.get("daemon", {})
    if daemon_info.get("running"):
        print(f"  • 守护进程 (Daemon): 运行中 (PID {daemon_info.get('pid')})")
    else:
        print("  • 守护进程 (Daemon): 未运行 (无活动常驻进程)")

    sock_info = diag.get("socket2", {})
    if sock_info.get("connected"):
        print(f"  • Hyprland Socket2: 已连通 ({sock_info.get('path')})")
    else:
        print(f"  • Hyprland Socket2: ❌ 未连通 ({sock_info.get('path') or '未找到'})")

    state = diag.get("state", {})
    print(f"  • 当前模式: {state.get('name', '未知')} ({state.get('mode', '未知')})")

    ov = diag.get("overlay", {})
    print(f"  • 内存热绑定生效: {ov.get('verified_in_hyprland')}/{ov.get('count')} 项匹配")

    print(f"  • Schema 与 Profile 一致性: {'✅ 100% 校验通过' if diag.get('consistency') else '❌ 校验失败'}")

    inst = diag.get("install", {})
    if inst:
        plugins = inst.get("plugins", {})
        ok_plugins = sum(1 for v in plugins.values() if v == "ok")
        print(f"  • 命令行链接: {'✅ 正常' if inst.get('cli') == 'ok' else '❌ ' + str(inst.get('cli'))}")
        print(f"  • 插件链接: {ok_plugins}/{len(plugins)} 正常")
        print(f"  • 后台服务: {inst.get('service')}")
        print(f"  • 颜色 Token: {'✅ 已同步' if inst.get('tokens_in_sync') else '❌ 未同步'}")

    om = diag.get("omarchy", {})
    if om:
        st = om.get("status")
        if st == "ok":
            print(f"  • Omarchy 版本: ✅ {om.get('detected')} (要求 >= {om.get('minimum')})")
        elif st == "too_old":
            print(f"  • Omarchy 版本: ❌ {om.get('detected')} 过旧 (要求 >= {om.get('minimum')})")
        else:
            print(f"  • Omarchy 版本: ⚠️ 未知（无法检测，要求 >= {om.get('minimum')}）")

    issues = diag.get("issues", [])
    if issues:
        print("\n⚠️ 诊断发现的问题:")
        for iss in issues:
            print(f"    - {iss}")
        fixes = list(dict.fromkeys(diag.get("fixes", [])))
        if fixes:
            print("\n🔧 建议修复:")
            for fx in fixes:
                print(f"    $ {fx}")
        sys.exit(1)
    else:
        print("\n🎉 系统运行良好，无冲突与异常。")

def cmd_list(engine: OmniPalEngine, args):
    profiles = engine.list_profiles()
    if args.json:
        print(json.dumps(profiles, ensure_ascii=False))
        return
    print(f"{'模式 ID'.ljust(12)}{'模式名称'.ljust(22)}{'快捷键数'.ljust(10)}{'来源'.ljust(12)}{'说明'}")
    print("-" * 75)
    for p in profiles:
        src = "用户目录" if p["source"] == "user" else "项目内置"
        if p.get("override"):
            src += " (覆盖)"
        print(f"{p['id'].ljust(12)}{p['name'].ljust(22)}{str(p['bindings_count']).ljust(10)}{src.ljust(12)}{p['description']}")


PROFILE_ID_RE = __import__("re").compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")

def _clean_profile(p_data: dict) -> dict:
    """Drops engine-internal fields (prefixed with _) so the profile is portable."""
    return {k: v for k, v in p_data.items() if not k.startswith("_")}

def cmd_export(engine: OmniPalEngine, args):
    p_id = args.profile.lower().strip()
    if p_id not in engine.profiles:
        print(f"❌ 找不到模式 '{p_id}'。可用模式: {', '.join(engine.profiles)}", file=sys.stderr)
        sys.exit(1)
    text = json.dumps(_clean_profile(engine.profiles[p_id]), ensure_ascii=False, indent=2) + "\n"
    if not args.output or args.output == "-":
        sys.stdout.write(text)
        return
    out = Path(args.output).expanduser()
    if out.exists() and not args.force:
        print(f"❌ {out} 已存在，加 --force 覆盖", file=sys.stderr)
        sys.exit(1)
    out.write_text(text, encoding="utf-8")
    print(f"✅ 已导出 '{p_id}' 到 {out}")

def cmd_import(engine: OmniPalEngine, args):
    import tempfile, os
    from scripts.check_consistency import _validate_profile_file
    try:
        raw = sys.stdin.read() if args.file == "-" else Path(args.file).expanduser().read_text(encoding="utf-8")
        p_data = json.loads(raw)
    except Exception as e:
        print(f"❌ 读取失败: {e}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(p_data, dict) or not isinstance(p_data.get("bindings", []), list):
        print("❌ 文件不是有效的 OmniPal profile", file=sys.stderr)
        sys.exit(1)
    p_data = _clean_profile(p_data)
    if args.id:
        p_data["id"] = args.id
    p_id = str(p_data.get("id", "")).lower().strip()
    if not PROFILE_ID_RE.match(p_id):
        print(f"❌ 模式 ID '{p_id}' 不合法：只能用小写字母、数字、- 和 _，最长 32 位。可用 --id 指定新 ID", file=sys.stderr)
        sys.exit(1)
    p_data["id"] = p_id
    p_data.setdefault("name", p_id)

    existing = engine.profiles.get(p_id)
    if existing and not args.force:
        kind = "内置模式" if existing.get("_source") == "project" else "已有的自定义模式"
        print(f"❌ '{p_id}' 与{kind}重名。用 --id 换个名字，或加 --force 覆盖", file=sys.stderr)
        sys.exit(1)

    valid_actions = engine.actions_catalog
    with tempfile.TemporaryDirectory() as td:
        tmp = Path(td) / f"{p_id}.json"
        tmp.write_text(json.dumps(p_data, ensure_ascii=False), encoding="utf-8")
        if not _validate_profile_file(tmp, valid_actions):
            print("❌ 校验未通过，未导入", file=sys.stderr)
            sys.exit(1)

    # 自定义命令会在按键时被执行，导入前列出来让用户心里有数
    commands = []
    for b in p_data.get("bindings", []):
        if b.get("action") not in LUA_DISPATCHERS and b.get("arg"):
            commands.append(f"  {b.get('mod', '')} {b.get('key', '')}  ->  {b['arg']}")
    if commands:
        print("⚠️  这个 profile 会在按键时执行以下命令，请确认来源可信：")
        print("\n".join(commands))
        if not args.yes:
            if not sys.stdin.isatty() or args.file == "-":
                print("❌ 含自定义命令，非交互环境请加 --yes 确认", file=sys.stderr)
                sys.exit(1)
            if input("继续导入？[y/N] ").strip().lower() not in ("y", "yes"):
                print("已取消")
                sys.exit(1)

    dest_dir = engine.user_profiles_dir
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / f"{p_id}.json"
    fd, tmp_path = tempfile.mkstemp(dir=dest_dir, suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(p_data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp_path, dest)
    print(f"✅ 已导入 '{p_id}'（{len(p_data.get('bindings', []))} 个快捷键）到 {dest}")
    print(f"   切换: omni-profile switch {p_id}")

def cmd_persist(engine: OmniPalEngine, args):
    action = getattr(args, "persist_action", None)

    if action == "status":
        status = engine.get_persistence_status()
        if args.json:
            print(json.dumps(status, indent=2, ensure_ascii=False))
            return
        if status["enabled"]:
            print("💾 OmniPal 配置持久化: ✅ 已启用（关机/重启自动记住上次配置）")
            print(f"  • 持久化模式 (Profile): {status.get('profile') or '跟随当前'}")
            print(f"  • 窗口策略 (Window Policy): {status.get('window_policy') or '跟随当前'}")
            print(f"  • 最近更新: {status.get('updated_at') or '未知'}")
        else:
            print("💾 OmniPal 配置持久化: ⏸ 已禁用（重启不恢复上次配置；本地统计仍独立记录）")
        print(f"  • 配置文件: {status['path']}")
        return

    if action == "enable":
        policy = getattr(args, "policy", None)
        if not engine.set_persistence(True, profile=args.profile, window_policy=policy):
            print("❌ 启用持久化被拒绝：模式或策略无效，或配置写入失败", file=sys.stderr)
            sys.exit(1)
        status = engine.get_persistence_status()
        print(f"✅ 已启用配置持久化: 模式 '{status['profile']}', 策略 '{status.get('window_policy')}' 记录于 {status['path']}")
        print("   后续 switch / cycle / 策略调整后将自动同步持久化（可随时执行 persist disable 关闭）。")
        return

    if action == "disable":
        if not engine.set_persistence(False):
            print("❌ 关闭持久化失败，请检查配置文件权限", file=sys.stderr)
            sys.exit(1)
        print("✅ 已关闭配置持久化（重启后不恢复；本地统计仍由 stats.json 独立记录）")
        return

    print("用法: omni-profile persist <status|enable|disable>", file=sys.stderr)
    sys.exit(1)

def _print_stat_rank(title: str, counts: dict, top: int = 10):
    print(f"\n{title}")
    if not counts:
        print("  （暂无记录）")
        return
    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], str(kv[0])))[:top]
    for i, (name, cnt) in enumerate(ranked, 1):
        print(f"  {i}. {str(name).ljust(22)}{cnt} 次")

def _resolve_current_class(engine: OmniPalEngine, args):
    """For --current: count down so the user can focus the target app, then read its window class."""
    import time
    delay = max(0, int(getattr(args, "delay", 3) or 0))
    if delay:
        print(f"⏳ 请在 {delay} 秒内切换到要设置规则的应用窗口…", flush=True)
        for left in range(delay, 0, -1):
            print(f"   {left}…", flush=True)
            time.sleep(1)
    win = engine.get_active_window() or {}
    cls = (win.get("class") or win.get("initialClass") or "").strip()
    if not cls:
        print("❌ 读不到当前焦点窗口的类名（Hyprland 没在运行，或焦点在桌面上）", file=sys.stderr)
        sys.exit(1)
    print(f"🎯 当前应用: {cls}")
    return cls

def cmd_rules(engine: OmniPalEngine, args):
    data = engine.load_app_rules()
    act = args.rules_action or "list"
    if act in ("add", "test") and getattr(args, "current", False):
        if act == "add":
            # `rules add --current mac`: argparse puts the mode into window_class
            if args.mode is None:
                args.mode = args.window_class
        args.window_class = _resolve_current_class(engine, args)
    if act == "add" and (not args.window_class or not args.mode):
        print("❌ 用法: omni-profile rules add <窗口类名> <模式>，或 omni-profile rules add --current <模式>", file=sys.stderr)
        sys.exit(1)
    if act == "test" and not args.window_class:
        print("❌ 用法: omni-profile rules test <窗口类名>，或 omni-profile rules test --current", file=sys.stderr)
        sys.exit(1)
    if act == "list":
        if getattr(args, "json", False):
            print(json.dumps(data, ensure_ascii=False))
            return
        print(f"应用规则: {'启用' if data['enabled'] else '停用'}，无匹配时回到: {data['default_mode'] or '手动选择的模式'}")
        if not data["rules"]:
            print("  （暂无规则，用 omni-profile rules add <窗口类名> <模式> 添加）")
        for i, r in enumerate(data["rules"], 1):
            flag = "" if r.get("enabled", True) else " [停用]"
            print(f"  {i}. {r['class']} ({r.get('match', 'exact')}) -> {r['mode']}{flag}")
        return
    if act == "add":
        data["rules"] = [r for r in data["rules"] if r["class"] != args.window_class]
        data["rules"].append({"class": args.window_class, "match": args.match, "mode": args.mode, "enabled": True})
    elif act == "remove":
        before = len(data["rules"])
        data["rules"] = [r for r in data["rules"] if r["class"] != args.window_class]
        if len(data["rules"]) == before:
            print(f"❌ 没有找到 {args.window_class} 的规则"); sys.exit(1)
    elif act == "toggle":
        hit = [r for r in data["rules"] if r["class"] == args.window_class]
        if not hit:
            print(f"❌ 没有找到 {args.window_class} 的规则"); sys.exit(1)
        for r in hit:
            r["enabled"] = not r.get("enabled", True)
    elif act in ("enable", "disable"):
        data["enabled"] = act == "enable"
    elif act == "default":
        data["default_mode"] = None if args.mode == "none" else args.mode
    elif act == "export":
        text = json.dumps({"omnipal_app_rules": 1, **data}, ensure_ascii=False, indent=2) + "\n"
        if not args.output or args.output == "-":
            sys.stdout.write(text); return
        out = Path(args.output).expanduser()
        if out.exists() and not args.force:
            print(f"❌ {out} 已存在，加 --force 覆盖", file=sys.stderr); sys.exit(1)
        out.write_text(text, encoding="utf-8")
        print(f"✅ 已导出 {len(data['rules'])} 条应用规则到 {out}")
        return
    elif act == "import":
        try:
            raw = sys.stdin.read() if args.file == "-" else Path(args.file).expanduser().read_text(encoding="utf-8")
            incoming = json.loads(raw)
        except Exception as e:
            print(f"❌ 读取失败: {e}", file=sys.stderr); sys.exit(1)
        if not isinstance(incoming, dict) or not isinstance(incoming.get("rules"), list):
            print("❌ 不是有效的应用规则文件（缺少 rules 列表）", file=sys.stderr); sys.exit(1)
        new_rules, skipped = [], []
        for r in incoming["rules"]:
            if not isinstance(r, dict) or not r.get("class") or not r.get("mode"):
                skipped.append(str(r)); continue
            if r["mode"] not in engine.profiles:
                skipped.append(f"{r['class']} -> {r['mode']}（本机没有这个模式，可先用 import 导入对应 profile）"); continue
            new_rules.append({"class": str(r["class"]), "match": r.get("match", "exact"),
                              "mode": r["mode"], "enabled": bool(r.get("enabled", True))})
        if args.replace:
            data["rules"] = new_rules
            if incoming.get("default_mode") in engine.profiles or incoming.get("default_mode") is None:
                data["default_mode"] = incoming.get("default_mode")
        else:
            incoming_classes = {r["class"] for r in new_rules}
            data["rules"] = [r for r in data["rules"] if r["class"] not in incoming_classes] + new_rules
        try:
            engine.save_app_rules(data)
        except (ValueError, Exception) as e:
            print(f"❌ {e}", file=sys.stderr); sys.exit(1)
        print(f"✅ 已导入 {len(new_rules)} 条应用规则（{'替换' if args.replace else '合并'}）")
        for sk in skipped:
            print(f"  ⚠️  跳过: {sk}")
        return
    elif act == "test":
        r = engine.match_app_rule(args.window_class, data)
        print(f"{args.window_class} -> {r['mode'] if r else '无匹配'}")
        return
    try:
        engine.save_app_rules(data)
    except ValueError as e:
        print(f"❌ {e}"); sys.exit(1)
    print("✅ 应用规则已保存，守护进程会在下次切换焦点时生效")

def cmd_stats(engine: OmniPalEngine, args):
    if args.reset:
        if not engine.reset_stats():
            print("❌ 重置本地使用统计失败", file=sys.stderr)
            sys.exit(1)
        print("✅ 已重置本地使用统计（stats.json 计数已全部清空）")

    stats = engine.get_stats()
    if args.json:
        print(json.dumps(stats, indent=2, ensure_ascii=False))
        return

    total = sum(stats["switches"].values()) + sum(stats["snaps"].values()) + sum(stats["actions"].values())
    print("📊 OmniPal 本地使用统计（纯本地聚合计数，零按键内容记录，零网络上传）")
    print(f"  • 统计文件: {stats_file_path()}")
    print(f"  • 累计事件: {total}")
    print(f"  • 最近更新: {stats.get('last_updated') or '无'}")
    print(f"  • 上次重置: {stats.get('last_reset') or '从未'}")
    _print_stat_rank("🔁 模式切换频次排行:", stats["switches"])
    _print_stat_rank("🧲 吸附区域使用 Top 榜:", stats["snaps"])
    _print_stat_rank("⚡ 动作触发统计排行:", stats["actions"])

def main():
    engine = OmniPalEngine(PROJECT_ROOT)

    parser = argparse.ArgumentParser(
        prog="omni-profile",
        description="OmniPal 运行时内存热切换控制工具 (v1.8.0)"
    )
    subparsers = parser.add_subparsers(dest="command", help="子命令")

    # status
    p_status = subparsers.add_parser("status", help="查看当前模式与状态")
    p_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_status.set_defaults(func=cmd_status)

    # list
    p_list = subparsers.add_parser("list", help="列出所有可用快捷键模式（内置与用户自定义）")
    p_list.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_list.set_defaults(func=cmd_list)

    # export / import
    p_export = subparsers.add_parser("export", help="导出一个模式为 JSON，便于分享")
    p_export.add_argument("profile", help="要导出的模式 ID")
    p_export.add_argument("-o", "--output", help="输出文件（默认打印到终端）")
    p_export.add_argument("--force", action="store_true", help="覆盖已存在的输出文件")
    p_export.set_defaults(func=cmd_export)

    p_import = subparsers.add_parser("import", help="从 JSON 文件导入自定义模式（- 表示从标准输入读取）")
    p_import.add_argument("file", help="profile JSON 文件路径，或 -")
    p_import.add_argument("--id", help="以新的模式 ID 导入")
    p_import.add_argument("--force", action="store_true", help="允许覆盖同名模式")
    p_import.add_argument("-y", "--yes", action="store_true", help="含自定义命令时不再询问")
    p_import.set_defaults(func=cmd_import)

    # switch
    p_switch = subparsers.add_parser("switch", help="切换至指定快捷键模式")
    p_switch.add_argument("mode", help="目标模式 (如 windows, mac, omarchy 或用户自定义模式)")
    p_switch.set_defaults(func=cmd_switch)

    # cycle
    p_cycle = subparsers.add_parser("cycle", help="在可用模式间轮转切换")
    p_cycle.add_argument("--reverse", action="store_true", help="反向轮转切换")
    p_cycle.set_defaults(func=cmd_cycle)

    # restore
    p_restore = subparsers.add_parser("restore", help="撤销所有覆盖，恢复系统原始快捷键")
    p_restore.set_defaults(func=cmd_restore)

    # cheatsheet
    p_cheat = subparsers.add_parser("cheatsheet", help="查看当前模式快捷键速查表")
    p_cheat.add_argument("mode", nargs="?", default=None, help="指定模式（默认当前）")
    p_cheat.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_cheat.set_defaults(func=cmd_cheatsheet)

    # snap
    p_send = subparsers.add_parser("send", help="把快捷键转发给当前窗口（终端自动改为 Ctrl+Shift）")
    p_send.add_argument("keys", nargs="+", help="例如: CTRL W")
    p_send.add_argument("--class", dest="window_class", default=None, help="指定窗口类名（默认读取当前焦点窗口）")
    p_send.set_defaults(func=cmd_send)

    p_snap = subparsers.add_parser("snap", help="触发窗口吸附分屏或呼出吸附布局菜单")
    p_snap.add_argument("zone", help="目标吸附区域 (如 left, right, top-left, center, third-center) 或 layouts (呼出选择器)")
    p_snap.add_argument("address", nargs="?", default=None, help="目标窗口十六进制地址 (如 0x56c7c335e060，默认探测鼠标悬停窗口或活动窗口)")
    p_snap.add_argument("--no-hud", action="store_true", help="静默吸附，不弹出视觉 HUD 反馈")
    p_snap.set_defaults(func=cmd_snap)

    # snap-layouts
    p_snap_layouts = subparsers.add_parser("snap-layouts", help="获取规范窗口吸附布局与区域配置")
    p_snap_layouts.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_snap_layouts.set_defaults(func=cmd_snap_layouts)

    # benchmark
    p_bench = subparsers.add_parser("benchmark", help="执行性能基准测试与耗时统计")
    p_bench.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_bench.set_defaults(func=cmd_benchmark)

    # doctor
    p_doc = subparsers.add_parser("doctor", help="执行系统状态与按键一致性健康诊断")
    p_doc.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_doc.set_defaults(func=cmd_doctor)

    # daemon
    p_daemon = subparsers.add_parser("daemon", help="前台运行守护进程（带自动退出恢复）")
    p_daemon.set_defaults(func=lambda eng, args: run_daemon())

    # persist
    p_persist = subparsers.add_parser("persist", help="管理配置持久化（默认开启，自动记住关机前配置）")
    persist_sub = p_persist.add_subparsers(dest="persist_action", required=True, help="持久化操作")
    p_p_status = persist_sub.add_parser("status", help="查看持久化状态与配置文件路径")
    p_p_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_p_status.set_defaults(func=cmd_persist)
    p_p_enable = persist_sub.add_parser("enable", help="启用持久化并记录目标模式与策略（默认当前模式）")
    p_p_enable.add_argument("profile", nargs="?", default=None, help="要持久化的模式（默认当前已激活模式；非法模式将被拒绝）")
    p_p_enable.add_argument("--policy", choices=["tiled", "floating"], default=None, help="要持久化的窗口策略（默认当前策略）")
    p_p_enable.set_defaults(func=cmd_persist)
    p_p_disable = persist_sub.add_parser("disable", help="关闭重启恢复（本地统计仍独立记录）")
    p_p_disable.set_defaults(func=cmd_persist)

    # stats
    p_rules = subparsers.add_parser("rules", help="按应用自动切换模式的规则（需运行守护进程）")
    rules_sub = p_rules.add_subparsers(dest="rules_action")
    r_list = rules_sub.add_parser("list", help="列出规则")
    r_list.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    r_add = rules_sub.add_parser("add", help="添加或更新一条规则")
    r_add.add_argument("window_class", nargs="?", help="窗口类名，可用 hyprctl activewindow 查看；用 --current 时省略")
    r_add.add_argument("mode", nargs="?", help="目标模式")
    r_add.add_argument("--current", action="store_true", help="倒计时后取当前焦点窗口的类名")
    r_add.add_argument("--delay", type=int, default=3, help="--current 的倒计时秒数（默认 3，0 表示立即读取）")
    r_add.add_argument("--match", choices=["exact", "prefix", "regex"], default="exact")
    r_rm = rules_sub.add_parser("remove", help="删除一条规则")
    r_rm.add_argument("window_class")
    r_tg = rules_sub.add_parser("toggle", help="启用或停用某一条规则")
    r_tg.add_argument("window_class")
    rules_sub.add_parser("enable", help="启用自动切换")
    rules_sub.add_parser("disable", help="停用自动切换")
    r_def = rules_sub.add_parser("default", help="无匹配时回到的模式（none 表示回到手动选择的模式）")
    r_def.add_argument("mode")
    r_exp = rules_sub.add_parser("export", help="导出应用规则为 JSON")
    r_exp.add_argument("-o", "--output", help="输出文件（默认打印到终端）")
    r_exp.add_argument("--force", action="store_true", help="覆盖已存在的输出文件")
    r_imp = rules_sub.add_parser("import", help="导入应用规则（默认按类名合并，- 表示标准输入）")
    r_imp.add_argument("file")
    r_imp.add_argument("--replace", action="store_true", help="用导入的规则整体替换现有规则")
    r_test = rules_sub.add_parser("test", help="测试某个窗口类名会匹配到哪个模式")
    r_test.add_argument("window_class", nargs="?")
    r_test.add_argument("--current", action="store_true", help="倒计时后测试当前焦点窗口")
    r_test.add_argument("--delay", type=int, default=3, help="--current 的倒计时秒数")
    p_rules.set_defaults(func=cmd_rules)

    p_stats = subparsers.add_parser("stats", help="查看本地使用统计（切换/吸附/动作排行，完全本地零上传；--reset 清空）")
    p_stats.add_argument("--json", action="store_true", help="以 JSON 格式输出")
    p_stats.add_argument("--reset", action="store_true", help="清空并重置全部本地统计")
    p_stats.set_defaults(func=cmd_stats)

    # window-policy / window-mode
    for cmd_name in ["window-policy", "window-mode"]:
        p_wp = subparsers.add_parser(cmd_name, help="查看或设置窗口策略 (tiled / floating / follow-profile)")
        p_wp.add_argument("--json", action="store_true", help="以 JSON 格式输出状态")
        p_wp.set_defaults(func=cmd_window_policy, policy_action="status")
        wp_sub = p_wp.add_subparsers(dest="policy_action", help="策略操作")

        wp_status = wp_sub.add_parser("status", help="查看当前窗口策略状态")
        wp_status.add_argument("--json", action="store_true", help="以 JSON 格式输出")
        wp_status.set_defaults(func=cmd_window_policy)

        wp_set = wp_sub.add_parser("set", help="设置窗口策略")
        wp_set.add_argument("policy", help="目标策略 (tiled, floating, follow-profile 或别名)")
        wp_set.add_argument("--json", action="store_true", help="以 JSON 格式输出结果")
        wp_set.set_defaults(func=cmd_window_policy)

        for direct_p in ["tiled", "tile", "floating", "float", "follow-profile", "follow", "follow_profile"]:
            wp_direct = wp_sub.add_parser(direct_p, help=f"快速切换至策略: {direct_p}")
            wp_direct.add_argument("--json", action="store_true", help="以 JSON 格式输出结果")
            wp_direct.set_defaults(func=cmd_window_policy, policy_action="set", target_policy=direct_p)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(engine, args)

if __name__ == "__main__":
    main()
